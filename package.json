{
  "name": "wrote",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source, AI-native workspace for writing books.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && node cli/build.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project nuxt",
    "test:api": "vitest run --project api",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "simple-git-hooks",
    "build:cli": "node cli/build.mjs",
    "eval:extraction": "vitest run --project unit server/codex/extraction-eval.test.ts",
    "export:check": "WROTE_EXPORT_CHECK=1 vitest run --project unit server/export/export-check.test.ts",
    "eval:review": "vitest run --project unit server/review/review-eval.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/google": "^4.0.82",
    "@ai-sdk/mistral": "^4.0.52",
    "@ai-sdk/openai": "^4.0.78",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@ai-sdk/vue": "^4.0.118",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@nuxt/ui": "^4.11.2",
    "@pinia/colada": "^1.4.6",
    "@pinia/colada-nuxt": "^1.2.0",
    "@pinia/nuxt": "^1.0.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/vue-3": "3.31.3",
    "@vueuse/core": "^15.0.0",
    "ai": "^7.0.118",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "marked": "^18.0.14",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.18",
    "@iconify-json/lucide": "^1.2.137",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.2",
    "vue-router": "5.3.1",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm typecheck"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs,vue}": [
      "eslint --fix --cache",
      "vitest related --run --passWithNoTests"
    ]
  },
  "bin": {
    "wrote": "./dist/cli/wrote.mjs"
  }
}
